# ---------------------------------------------------------------------------
# Example environment configuration.
# Copy this file to `.env` and adjust the values for your setup.
# The application reads these at startup (see src/brain_disease_detection/config.py).
# NEVER commit a real `.env` file — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# Flask runtime -------------------------------------------------------------
# Environment: "development" enables debug reloading, "production" disables it.
APP_ENV=development

# Host/port the web server binds to.
HOST=0.0.0.0
PORT=8000

# Secret key used by Flask for session signing. Generate a random value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Maximum accepted upload size in megabytes (rejected above this).
MAX_UPLOAD_MB=10

# Model configuration -------------------------------------------------------
# Directory containing the trained *.keras model files.
MODELS_DIR=models

# Path to the YAML configuration file.
CONFIG_PATH=configs/config.yaml

# Logging -------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
